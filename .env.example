OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=12000
PORT=3000

# Hosted private-beta settings
USE_BUNDLED_CORPUS=false
AUTH_REQUIRED=false
LOCAL_FILE_ACCESS=true
ALLOW_CLIENT_API_KEYS=true
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ALLOW_SIGNUPS=false
